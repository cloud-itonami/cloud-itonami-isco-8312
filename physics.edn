;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a rail operations scheduling and logging robot
;; logs service records, coordinates crew rosters and drafts maintenance
;; orders; it never throws a switch, clears a signal or finalises routing.
;; Its physical work is lineside maintenance support: running a track trolley
;; with signal spares along a graded section inside a possession, and the
;; heat that reaches the relays in an insulated lineside location case.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-8312"
 :cases
 [{:id :spares-trolley-on-grade
   :kind :transport
   :procedure "powered track trolley carries signal and point-machine spares 400 m along a 1 degree grade to the work site"
   :params {:mass-kg 250.0 :distance-m 400.0 :v-max-mps 3.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 700.0 :crr 0.003 :slope-deg 1.0
            :cog-height-m 0.50 :support-half-length-m 0.50 :max-time-s 1800.0}
   :sweep {:param :payload-kg :values [100.0 500.0 1000.0 1500.0 2000.0 2500.0]}
   :quantity :cycle-time-s
   :limit {:max 180.0 :basis "estimate: three minutes of travel per leg inside a short engineering possession"}
   :boundary {:lo 50.0 :hi 3500.0}}
  {:id :location-case-relays
   :kind :thermal
   :procedure "insulated lineside location case (25 mm foam wall) in afternoon sun for 4 hours; outer face sees the sol-air temperature, inner face the relay-rack air"
   :params {:thickness-m 0.025 :conductivity-w-mk 0.025 :density-kg-m3 40.0 :specific-heat-j-kgk 1500.0
            :t0-c 25.0 :h-front-w-m2k 20.0 :t-back-ambient-c 30.0 :h-back-w-m2k 5.0
            :threshold-c 45.0 :duration-s 14400.0 :nodes 11}
   :sweep {:param :t-hot-c :values [40.0 55.0 70.0 85.0]}
   :quantity :peak-back-c
   :limit {:max 45.0 :basis "estimate: inner wall temperature above which relay-rack air cooling is taken to be at risk"}}]}
